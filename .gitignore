# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Secrets (never commit)
.env
.env.*
*.key
*.pem
credentials*.json

# Data artifacts (large / regenerable)
artifacts/interface_matrix/*.lock
artifacts/**/*.tmp
artifacts/**/*.partial

# Test / tool caches (regenerable)
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini

# Logs
*.log
